# Copy this file to `.env` and fill in local credentials.

OPENAI_API_KEY=

# Optional LLM configuration
#
# By default, NeuroDivSim uses OpenAI with the model `gpt-4o-mini`.
#
# Alternatively, another OpenAI-compatible endpoint can be used,
# for example a locally running Ollama model.
# Set the following variables only when needed:
#
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_API_KEY=

# Optional: more detailed error messages for local development.
# COGSIM_DEBUG=false

# Optional: override the backend URL used by the frontend.
# Default: http://127.0.0.1:8000
# NEURODIVSIM_BACKEND_URL=http://127.0.0.1:8000

# Optional: start the frontend with mock data.
# COGSIM_USE_MOCK_DATA=false
